run = "cd backend && pip install -r requirements.txt && python -m uvicorn main:app --host 0.0.0.0 --port 5000"

[nix]
channel = "stable-23_11"

[env]
PYTHONPATH = "${REPL_HOME}/backend"

[deployment]
run = ["sh", "-c", "cd backend && python -m uvicorn main:app --host 0.0.0.0 --port 5000"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80

[languages]
[languages.python3]
pattern = "**/*.py"

[languages.python3.languageServer]
start = "pylsp"
